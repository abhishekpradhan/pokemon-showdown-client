{
  "name": "showdown-arena",
  "version": "1.2.0",
  "description": "A modern, standalone Pokémon Showdown battle client",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:live": "node scripts/live-smoke.mjs",
    "test:integration": "node scripts/test-local-server.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "test:production": "playwright test --config playwright.production.config.ts",
    "test:visual": "playwright test e2e/visual.spec.ts --project=chromium --project=mobile",
    "check:licenses": "node scripts/check-licenses.mjs",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high",
    "test:stress": "node scripts/test-session-stress.mjs",
    "test:integration:guard": "vitest run scripts/local-server-guard.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:dependencies:all": "npm audit --audit-level=low"
  },
  "dependencies": {
    "@pkmn/client": "^0.7.3",
    "@pkmn/data": "^0.10.11",
    "@pkmn/dex": "^0.10.11",
    "@pkmn/img": "^0.3.4",
    "@pkmn/protocol": "^0.7.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-router": "^1.133.20",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "axe-core": "^4.12.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.2.4",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhishekpradhan/pokemon-showdown-client.git"
  },
  "homepage": "https://github.com/abhishekpradhan/pokemon-showdown-client#readme",
  "bugs": {
    "url": "https://github.com/abhishekpradhan/pokemon-showdown-client/issues"
  }
}
