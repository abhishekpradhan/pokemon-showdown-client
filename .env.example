# Copy to .env.local and edit. Every value below is optional — the defaults
# point at the public Pokémon Showdown server.

# ── Battle server (WebSocket) ────────────────────────────────────────────
# The client connects straight from the browser to a PS-compatible server.
VITE_PS_SERVER_HOST=sim3.psim.us
VITE_PS_SERVER_PORT=443
VITE_PS_SERVER_PREFIX=/showdown
VITE_PS_SERVER_SECURE=true
VITE_PS_SERVER_ID=showdown

# ── Login server (HTTP) ──────────────────────────────────────────────────
# action.php sends no CORS headers, so the browser cannot call it directly.
# Requests go to a same-origin path that the dev server and the serverless
# function in api/action.ts both proxy. Point this elsewhere only if you are
# hosting your own equivalent.
VITE_PS_ACTION_URL=/api/action

# Server-side only (never exposed to the browser): the upstream that
# api/action.ts and the Vite dev proxy forward to.
PS_LOGIN_SERVER=https://play.pokemonshowdown.com/action.php

# ── Assets ───────────────────────────────────────────────────────────────
# Sprites, icons and audio. Self-host by pointing this at your own mirror.
VITE_PS_SPRITE_HOST=https://play.pokemonshowdown.com

# ── Development toggles ──────────────────────────────────────────────────
# Skip auto-connecting on boot (useful when working offline).
VITE_PS_AUTOCONNECT=true
# Serve a fixed sample battle at /battle/demo-gen9ou for UI work.
VITE_ENABLE_DEMO_FIXTURES=false
